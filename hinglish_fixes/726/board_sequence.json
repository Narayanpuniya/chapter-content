{
  "items": [
    {
      "when_concept": "भिन्नों का गुणन – क्षेत्रफल से शुरुआत",
      "write": [
        "आयत का क्षेत्रफल = लंबाई × चौड़ाई",
        "उदाहरण: 7 cm × 4 cm = 28 cm²",
        "अगर भुजाएँ भिन्न हों: 7½ × 3½ = 15/2 × 7/2 → भिन्नों का गुणन ज़रूरी"
      ]
    },
    {
      "when_concept": "एक भिन्न का पूर्ण संख्या से गुणन",
      "write": [
        "2 × (1/4) = 2/4   और   3 × (1/2) = 3/2",
        "नियम: पूर्ण संख्या × अंश / हर  (हर अपरिवर्तित)",
        "उदाहरण: 5 × (2/3) = 10/3 ;  2 × (3/7) = 6/7"
      ]
    },
    {
      "when_concept": "विषम एवं मिश्रित भिन्न × पूर्ण संख्या",
      "write": [
        "विषम भिन्न: 3 × (5/2) = 15/2",
        "मिश्रित → विषम → गुणा: 4⅖ = 22/5;  22/5 × 5 = 22",
        "6⅓ × 7 = 19/3 × 7 = 57/7 = 8 1/7"
      ]
    },
    {
      "when_concept": "भिन्न प्रचालक 'का' के रूप में",
      "write": [
        "'का' = गुणन (multiplication)",
        "2 का 1/2 = (1/2)×2 = 1 ;  3 का 1/2 = (1/2)×3 = 3/2",
        "20 का 1/5 = (1/5)×20 = 4"
      ]
    },
    {
      "when_concept": "'का' से रोज़मर्रा की समस्याएँ",
      "write": [
        "40 का 1/5 = 8 (अंग्रेज़ी);  40 का 2/5 = 16 (गणित)",
        "विज्ञान = 40 − 24 = 16 ; भिन्न = 16/40",
        "पिकनिक: 5 L का 2/5 = 2 L (विद्या); प्रताप का भाग = 3/5"
      ]
    },
    {
      "when_concept": "भिन्न का भिन्न से गुणन",
      "write": [
        "(1/2)×(1/3) = 1/6 = (1×1)/(2×3)",
        "पूरे को 2×3 = 6 भागों में बाँटा → 1 भाग = 1/6",
        "(1/2)×(1/3) = (1/3)×(1/2) = 1/6  (क्रम बदलो, गुणनफल समान)"
      ]
    },
    {
      "when_concept": "दो भिन्नों के गुणन का नियम",
      "write": [
        "(a/b)×(c/d) = (a×c)/(b×d)",
        "(1/2)×(5/3) = 5/6 ;  (3/5)×(1/7) = 3/35",
        "(2/3)×(7/5) = 14/15   → अंश×अंश / हर×हर"
      ]
    },
    {
      "when_concept": "गुणनफल का मान – उचित और विषम भिन्नें",
      "write": [
        "उचित × उचित → गुणनफल दोनों से छोटा  (8/15 < 2/3, 4/5)",
        "विषम × विषम → गुणनफल दोनों से बड़ा  (35/6 > 7/3, 5/2)",
        "उचित × विषम → एक से छोटा, एक से बड़ा  (14/15)"
      ]
    }
  ]
